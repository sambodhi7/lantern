# Copy to bridge/.env.local and use Onmeta STAGING values from its dashboard.
# Do not put ONMETA_API_SECRET in frontend files or version control.
ONMETA_API_KEY=
ONMETA_API_SECRET=
ONMETA_TREASURY_ADDRESS=
ONMETA_ENVIRONMENT=staging
ONMETA_CHAIN_ID=1
ONMETA_TOKEN_SYMBOL=ETH
LANTERN_CAMPAIGN_ID=1
# Deployed LanternLedger address and a JSON-RPC URL on the same network.
LANTERN_LEDGER_ADDRESS=
LANTERN_RPC_URL=
BRIDGE_PORT=8787
DATABASE_URL=postgresql://lantern@127.0.0.1:55432/lantern
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
# Optional: base64-encoded 32-byte AES key; otherwise a local .data/evidence.key is generated.
EVIDENCE_ENCRYPTION_KEY=
LANTERN_MIN_CONFIRMATIONS=2
# Public testnet deployment screen; works independently of Onmeta.
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
